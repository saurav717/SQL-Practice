{
  "name": "sql-practice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-based SQL practice on a toy analytics warehouse, built from a pre-onboarding prep guide and a rolling-windows/timestamps reference.",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "seed": "node tools/gen_seed.mjs",
    "check": "bash tools/check_all.sh",
    "check:exercises": "node tools/check_exercises.mjs",
    "check:grading": "node tools/check_grading.mjs",
    "check:schema": "node tools/check_schema_notes.mjs",
    "check:browser": "node tools/browser_test.mjs",
    "check:collector": "node tools/check_collector.mjs",
    "check:proxy": "node tools/check_proxy.mjs",
    "check:assistant": "node tools/check_assistant.mjs",
    "check:window": "node tools/check_window.mjs",
    "check:panes": "node tools/check_panes.mjs",
    "build:sdk": "node tools/build_anthropic.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@duckdb/node-api": "^1.4.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.50.0"
  }
}
